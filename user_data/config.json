    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },

    "unfilledtimeout": {
        "entry": 30,
        "exit": 30
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    "telegram": {
        "enabled": false,
        "token": "PLACEHOLDER",
        "chat_id": "PLACEHOLDER"
    },

    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "username": "wolf",
        "password": "wolf"
    },

    "datadir": "user_data/data/bybit",
    "user_data_dir": "user_data",

    "liquidation_buffer": 0.05,
    "position_adjustment_enable": true
